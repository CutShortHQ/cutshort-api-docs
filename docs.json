{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Cutshort API",
  "description": "Search India's tech talent database programmatically.",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.svg",
    "href": "https://cutshort.io"
  },
  "favicon": "/favicon.png",
  "fonts": {
    "family": "Inter"
  },
  "colors": {
    "primary": "#5851D3",
    "light": "#7B75E0",
    "dark": "#4540A8"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FAFAFA",
      "dark": "#0A0A0A"
    }
  },
  "api": {
    "openapi": "openapi/public-api-v1.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/mcp-server",
              "guides/search-candidates",
              "guides/get-candidate-details",
              "guides/profile-signals",
              "guides/post-a-job",
              "guides/list-jobs",
              "guides/invite-to-apply",
              "guides/send-message",
              "guides/list-stages",
              "guides/list-applications",
              "guides/move-application-stage",
              "guides/rate-limits"
            ]
          }
        ]
      },
      {
        "tab": "MCP Server",
        "pages": [
          "guides/mcp-server"
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi/public-api-v1.json"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Cutshort",
        "href": "https://cutshort.io"
      },
      {
        "label": "Get your API Key",
        "href": "https://developers.cutshort.io/introduction#getting-api-access"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://cutshort.io",
      "linkedin": "https://www.linkedin.com/company/cutshort",
      "x": "https://x.com/CutShortHQ",
      "instagram": "https://www.instagram.com/cutshorthq/",
      "facebook": "https://www.facebook.com/cutshorthq/"
    }
  }
}
